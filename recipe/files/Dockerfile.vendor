# from requirements.lock (the freeze below), so an extra_pip runtime dep that is wheeled but
# NOT in this lock-gen install is silently dropped from the final image.
RUN pip install --no-index --no-cache-dir --find-links /wheelhouse -c /wheelhouse/constraints.txt 'apache-airflow[postgres]==3.4.0'  --target /tmp/r && \
    pip freeze --path /tmp/r > /wheelhouse/requirements.lock && rm -rf /tmp/r
