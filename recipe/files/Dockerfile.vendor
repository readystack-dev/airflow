    grep -vEi '^(dnspython)[[:space:]]*(==|>=|<=|~=|!=|<|>|$)' /wheelhouse/upstream-constraints.txt > /wheelhouse/constraints.txt && \
    printf 'dnspython==2.9.2\n' >> /wheelhouse/constraints.txt && \
    echo "constraints: $(wc -l < /wheelhouse/constraints.txt) pins"
