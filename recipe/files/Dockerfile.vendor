ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends netbase tzdata curl ca-certificates git && rm -rf /var/lib/apt/lists/*
